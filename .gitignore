# ==============================================================================
# Homelab GitOps Monorepo .gitignore
# Strictly prevents committing secrets, persistent state, and certificates
# ==============================================================================

# Runtime application data & persistent volumes
**/data/
**/postgresql/
**/uploads/
**/backup/
**/backups/
**/assets/
**/config/
**/media/
**/downloads/
**/torrents/
**/work/
**/logs/
*.log

# Secrets, Environment Files & Keys
*.env
*.env.*
!*.env.example
*.key
*.crt
*.pem
*.pfx
*.p12

# Custom Application Configs containing secrets
**/config.toml
!**/config.toml.example

# Ansible host inventories (protects internal LAN & Tailscale IPs)
ansible/inventory.ini
ansible/inventory*.ini
!ansible/inventory.ini.example

# Third-party standalone repositories
**/openGym/

# System and editor clutter
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
__pycache__/
*.py[cod]
*$py.class
