# AutoRox Storekeeper Credentials (ROLE_SPARESINCHARGE)
AUTOROX_USERNAME=whatomate
AUTOROX_PASSWORD=your_autorox_password_here

# Whatomate WhatsApp Gateway Configuration
# Connects to whatomate_app container over traefik_proxy network on internal port 8080
WHATOMATE_URL=http://whatomate_app:8080
WHATOMATE_API_KEY=whm_your_whatomate_api_key_here

# Inventory Sync Cadence (in minutes)
# Reuses proactive JWT cache (4hr life); refreshes automatically when < 20m remain
SYNC_INTERVAL_MINUTES=60
