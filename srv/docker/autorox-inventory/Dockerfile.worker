# Python Domain Worker Dockerfile for AutoRox Synchronization
FROM python:3.11-slim

WORKDIR /app

# Install system and Python dependencies via apt for instant, rock-solid builds
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    python3-requests \
    python3-pandas \
    python3-openpyxl \
    python3-xlrd \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONPATH=/usr/lib/python3/dist-packages

# Copy code
COPY sync_inventory.py .
COPY pillar2_inventory_service.py .
COPY worker_entrypoint.py .

# Environment defaults
ENV AUTOROX_USERNAME=whatomate
ENV AUTOROX_PASSWORD=""
ENV SYNC_INTERVAL_MINUTES=60
ENV OUTPUT_DIR=/app/data/live

ENTRYPOINT ["python3", "-u", "worker_entrypoint.py"]
