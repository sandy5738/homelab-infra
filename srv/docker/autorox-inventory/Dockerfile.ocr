# Official Pre-Built GPU-Accelerated PaddleOCR Image for NVIDIA GeForce GTX 1050 Mobile
FROM paddlecloud/paddleocr:2.6-gpu-cuda11.2-cudnn8-latest

WORKDIR /app

# Copy application source
COPY ocr_service.py .

# Environment configuration
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV DB_PATH=/app/data/live/inventory.db

EXPOSE 8005

ENTRYPOINT ["python3", "-u", "ocr_service.py", "--port", "8005"]
