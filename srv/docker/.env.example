# ==============================================================================
# Global Homelab Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env in /srv/docker or use per-service .env files.
#
# Compose files utilize standard parameter expansion with defaults:
#   ${VARIABLE:-default_value}
# You can override any variable here without modifying compose.yml files.
# ==============================================================================

# User & Timezone Defaults
PUID=1000
PGID=1000
TZ=Asia/Kolkata
UMASK=002

# Storage Mount Points
# Primary media library (NTFS / external storage mount):
MEDIA_DIR=/mnt/SandysHDD/Media

# Persistent application state directory (relative to each service directory):
DATA_DIR=./data

# Traefik Core Paths
DOCKER_SOCK=/var/run/docker.sock
ROUTES_FILE=./routes.yml
CERTS_DIR=./certs

# DNS Domain Defaults
DNS_SERVER_DOMAIN=ns1.nominomi.lan
HOMELAB_DOMAIN=nominomi.lan
